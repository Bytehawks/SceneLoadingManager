; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SceneLoaderManager"
config/version="1.0"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://c3p8144s75scc"

[autoload]

SceneLoader="*uid://kbml63ltj674"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/loadingscreen/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/loadingscreen/assets/": "red",
"res://addons/loadingscreen/scenes/": "blue",
"res://addons/loadingscreen/scripts/": "yellow",
"res://addons/loadingscreen/shader/": "orange",
"res://addons/loadingscreen/test/": "purple",
"res://addons/loadingscreen/themes/": "pink"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
